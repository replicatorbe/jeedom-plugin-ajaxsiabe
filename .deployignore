# Exclusions propres au plugin ajaxsiabe, ajoutées à celles de deploy-plugin.sh.
# Un motif rsync par ligne.

# Le journal SIA est produit à l'exécution et n'existe que côté Jeedom. Le
# déploiement travaille avec --delete : sans cette ligne, chaque déploiement
# effacerait tout l'historique des trames reçues.
data/journal/

# Décalage d'horloge appris par le démon pour chaque hub : sans cette ligne,
# un déploiement le ferait réapprendre, messages refusés à la clé.
data/clock.json
data/clock.json.tmp

# Jeux d'essai : outils de développement, inutiles côté Jeedom.
tests/
